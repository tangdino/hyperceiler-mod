diff --git a/library/libhook/src/main/java/com/sevtinge/hyperceiler/libhook/rules/systemui/statusbar/icon/all/HideNotificationDots.java b/library/libhook/src/main/java/com/sevtinge/hyperceiler/libhook/rules/systemui/statusbar/icon/all/HideNotificationDots.java
new file mode 100644
index 000000000..6a2eaeb09
--- /dev/null
+++ b/library/libhook/src/main/java/com/sevtinge/hyperceiler/libhook/rules/systemui/statusbar/icon/all/HideNotificationDots.java
@@ -0,0 +1,65 @@
+package com.sevtinge.hyperceiler.libhook.rules.systemui.statusbar.icon.all;
+
+import android.view.View;
+import com.sevtinge.hyperceiler.common.log.XposedLog;
+import com.sevtinge.hyperceiler.libhook.base.BaseHook;
+import io.github.lingqiqi5211.ezhooktool.xposed.java.IMethodHook;
+import io.github.lingqiqi5211.ezhooktool.xposed.common.HookParam;
+import java.lang.reflect.Field;
+import java.lang.reflect.Modifier;
+import io.github.libxposed.api.XposedInterface;
+
+/** Hides overflow dots while retaining SystemUI's icon layout and animation. */
+public final class HideNotificationDots extends BaseHook {
+    private static final int STATE_DOT = 1;
+    private static final int STATE_HIDDEN = 2;
+    private volatile boolean disabled;
+
+    @Override
+    public void init() {
+        Class<?> iconState = findClassIfExists(
+            "com.android.systemui.statusbar.phone.NotificationIconContainer$IconState", null);
+        if (iconState == null) {
+            XposedLog.w(TAG, "Notification IconState unavailable; skipping");
+            return;
+        }
+        try {
+            Field field = null;
+            for (Class<?> owner = iconState; owner != null; owner = owner.getSuperclass()) {
+                try {
+                    field = owner.getDeclaredField("visibleState");
+                    break;
+                } catch (NoSuchFieldException ignored) { }
+            }
+            if (field == null || field.getType() != int.class
+                || Modifier.isStatic(field.getModifiers()) || Modifier.isFinal(field.getModifiers())) {
+                XposedLog.w(TAG, "Incompatible visibleState field; skipping");
+                return;
+            }
+            iconState.getDeclaredMethod("applyToView", View.class);
+            field.setAccessible(true);
+            final Field visibleState = field;
+            disabled = false;
+            XposedInterface.HookHandle handle = findAndHookMethod(iconState, "applyToView", View.class, new IMethodHook() {
+                @Override
+                public void before(HookParam param) {
+                    if (disabled) return;
+                    try {
+                        Object state = param.getThisObject();
+                        if (visibleState.getInt(state) == STATE_DOT) {
+                            visibleState.setInt(state, STATE_HIDDEN);
+                        }
+                    } catch (IllegalAccessException | IllegalArgumentException failure) {
+                        if (!disabled) {
+                            disabled = true;
+                            XposedLog.w(TAG, "Field access failed; dot suppression disabled");
+                        }
+                    }
+                }
+            });
+            if (handle != null) registerHotReloadCleanup(handle::unhook);
+        } catch (ReflectiveOperationException | SecurityException failure) {
+            XposedLog.w(TAG, "Incompatible SystemUI; dot suppression skipped");
+        }
+    }
+}
