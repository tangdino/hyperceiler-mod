{
  "name": "桌面监控线程放弃策略",
  "order": 40,
  "desc": "桌面始终找不到 libapp.so 时退避到 500ms，60 秒后永久停止监视线程，消除单核 28.7% 占用。",
  "upstream_absorbed_if": [
    {
      "path": "app/src/main/cpp/targets/home/tweaks/entry.cpp",
      "contains": "GiveUp"
    },
    {
      "path": "app/src/main/cpp/targets/home/tweaks/entry.cpp",
      "contains": "gaveUp"
    },
    {
      "path": "app/src/main/cpp/targets/home/tweaks/entry.cpp",
      "contains": "give_up"
    }
  ],
  "our_markers": [
    {
      "path": "app/src/main/cpp/targets/home/tweaks/entry.cpp",
      "contains": "g_monitorGaveUp"
    },
    {
      "path": "app/src/main/cpp/targets/home/tweaks/entry.cpp",
      "contains": "kGiveUpGraceMs"
    }
  ]
}
