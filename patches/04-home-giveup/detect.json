{
  "name": "桌面监控线程放弃策略",
  "order": 40,
  "desc": "桌面始终找不到 libapp.so 时退避到 500ms，60 秒后永久停止监视线程，消除单核 28.7% 占用。上游 293cbc08 起已内建 MonitorPeriodMs() 自适应节流，按上游优先纪律判为 ABSORBED。",
  "upstream_absorbed_if": [
    {
      "path": "app/src/main/cpp/targets/home/tweaks/entry.cpp",
      "contains": "GiveUp"
    },
    {
      "path": "app/src/main/cpp/targets/home/tweaks/entry.cpp",
      "contains": "gaveUp"
    },
    {
      "path": "app/src/main/cpp/targets/home/tweaks/entry.cpp",
      "contains": "give_up"
    },
    {
      "path": "app/src/main/cpp/targets/home/tweaks/entry.cpp",
      "contains": "uint64_t MonitorPeriodMs(const State& state)"
    },
    {
      "path": "app/src/main/cpp/targets/home/tweaks/entry.cpp",
      "contains": "if (!state.imageFound || !state.configLoaded) return 1500;"
    }
  ],
  "our_markers": [
    {
      "path": "app/src/main/cpp/targets/home/tweaks/entry.cpp",
      "contains": "g_monitorGaveUp"
    },
    {
      "path": "app/src/main/cpp/targets/home/tweaks/entry.cpp",
      "contains": "kGiveUpGraceMs"
    }
  ]
}
